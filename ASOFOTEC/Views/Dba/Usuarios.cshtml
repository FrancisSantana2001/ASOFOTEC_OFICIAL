@using ASOFOTEC.Dtos
@model List<UsuarioAdminDto>

@{
    ViewData["Title"] = "Gestionar usuarios";
    var busqueda = ViewData["Busqueda"] as string;
    var actualId = Context.ObtenerUsuarioId();
}

<div class="mt-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h2 as-pagina-titulo mb-0">Gestionar usuarios</h1>
            <p class="text-muted mb-0">@Model.Count @(Model.Count == 1 ? "resultado" : "resultados") (se muestran los 200 más recientes).</p>
        </div>
        <a asp-action="Index" class="btn btn-as-outline"><i class="bi bi-speedometer2 me-1"></i>Volver al panel</a>
    </div>

    <form asp-action="Usuarios" method="get" class="mb-3" role="search">
        <div class="input-group">
            <input type="search" name="q" value="@busqueda" class="form-control" placeholder="Buscar por nombre o correo" aria-label="Buscar usuarios" />
            <button class="btn btn-as" type="submit"><i class="bi bi-search"></i></button>
        </div>
    </form>

    <div class="as-tarjeta-simple p-0">
        <div class="table-responsive">
            <table class="table table-sm align-middle tabla-dba mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Usuario</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Ingreso</th>
                        <th>Edad</th>
                        <th title="Problemas / soluciones / publicaciones / comentarios">Actividad</th>
                        <th class="pe-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var esDbaFila = u.Rol == "DBA";
                        var esYo = actualId.HasValue && actualId.Value == u.Id;
                        var avatar = AvatarVm.De(u.Nombre, u.FotoPerfilUrl, "feed-avatar");

                        <tr class="@(u.Activo ? "" : "table-secondary")">
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="avatar" />
                                    <div style="min-width:0">
                                        <div class="fw-semibold text-truncate">@u.Nombre</div>
                                        <div class="small text-muted text-truncate">@u.Correo</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (esDbaFila || esYo)
                                {
                                    <span class="badge @(esDbaFila ? "text-bg-dark" : "text-bg-light border")">@u.Rol</span>
                                }
                                else
                                {
                                    <form asp-action="CambiarRol" method="post" class="d-flex gap-1"
                                          data-confirm="¿Cambiar el rol de @(u.Nombre)?" data-confirm-titulo="Cambiar rol"
                                          data-confirm-ok="Cambiar" data-confirm-peligro="false">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="q" value="@busqueda" />
                                        <select name="rol" class="form-select form-select-sm" style="width:auto" aria-label="Rol de @u.Nombre">
                                            <option value="Usuario" selected="@(u.Rol == "Usuario")">Usuario</option>
                                            <option value="Admin" selected="@(u.Rol == "Admin")">Admin</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Guardar rol" aria-label="Guardar rol"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                            </td>

                            <td><span class="badge @(u.Activo ? "text-bg-success" : "text-bg-secondary")">@(u.Activo ? "Activo" : "Desactivado")</span></td>
                            <td class="small">@u.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td class="small">@(u.Edad.HasValue ? u.Edad.ToString() : "—")</td>
                            <td class="small text-nowrap">@u.Problemas / @u.Soluciones / @u.Publicaciones / @u.Comentarios</td>

                            <td class="pe-3 text-end">
                                @if (esDbaFila || esYo)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (u.Activo)
                                {
                                    <form asp-action="CambiarEstado" method="post"
                                          data-confirm="@u.Nombre no podrá iniciar sesión mientras su cuenta esté desactivada."
                                          data-confirm-titulo="Desactivar cuenta" data-confirm-ok="Desactivar">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="activo" value="false" />
                                        <input type="hidden" name="q" value="@busqueda" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="CambiarEstado" method="post">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="activo" value="true" />
                                        <input type="hidden" name="q" value="@busqueda" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4 mb-0">No se encontraron usuarios.</p>
        }
    </div>
</div>
