@model ASOFOTEC.Dtos.HomeDashboardDto

@{
    ViewData["Title"] = "Inicio";
    ViewData["BodyClass"] = "pagina-bienvenida";
}

<!-- ============ HERO ============ -->
<section class="as-hero" aria-labelledby="hero-titulo">
    <div class="as-hero-texto">
        <h1 id="hero-titulo">
            Tecnología con propósito,
            <span>impacto que transforma.</span>
        </h1>

        <p>
            En <strong>ASOFOTEC</strong> conectamos ideas, personas y tecnología para resolver
            problemas sociales y construir un futuro sostenible para nuestra comunidad.
        </p>

        <div class="as-hero-botones">
            <a asp-controller="Problema" asp-action="Index" class="btn btn-as btn-as-lg">
                Explorar Problemas <i class="bi bi-arrow-right ms-1"></i>
            </a>
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/Problema" class="btn btn-as-outline btn-as-lg">
                Proponer Solución <i class="bi bi-lightbulb ms-1"></i>
            </a>
        </div>
    </div>

    <div class="as-hero-imagen">
        <img src="~/img/landing/hero-manos.jpg" alt="Manos de distintas personas sosteniendo una planta que brota de la tierra" />
    </div>
</section>

<!-- ============ BENEFICIOS ============ -->
<section class="as-beneficios" aria-label="Qué puedes hacer en ASOFOTEC">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">

        <div class="col">
            <div class="as-beneficio">
                <div class="as-icono-circulo"><i class="bi bi-people" aria-hidden="true"></i></div>
                <div>
                    <h3>Conecta</h3>
                    <p>Únete a una comunidad apasionada por el cambio.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="as-beneficio">
                <div class="as-icono-circulo"><i class="bi bi-lightbulb" aria-hidden="true"></i></div>
                <div>
                    <h3>Propón</h3>
                    <p>Comparte ideas y soluciones a problemas reales.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="as-beneficio">
                <div class="as-icono-circulo"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i></div>
                <div>
                    <h3>Colabora</h3>
                    <p>Trabaja en proyectos que generen impacto positivo.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="as-beneficio">
                <div class="as-icono-circulo"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div>
                <div>
                    <h3>Transforma</h3>
                    <p>Juntos construimos un futuro más sostenible.</p>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ============ PROBLEMAS · SOLUCIONES · ÚNETE ============ -->
<section class="mb-4">
    <div class="row g-3">

        <!-- Problemas destacados -->
        <div class="col-md-6 col-lg-4">
            <div class="as-tarjeta as-tarjeta-problemas">
                <div class="as-tarjeta-cabecera">
                    <h2>Problemas Destacados</h2>
                    <a asp-controller="Problema" asp-action="Index" class="as-ver-todos">Ver todos</a>
                </div>

                @if (!Model.ProblemasDestacados.Any())
                {
                    <p class="text-muted small py-3 mb-0">Aún no hay problemas publicados.</p>
                }

                @foreach (var problema in Model.ProblemasDestacados)
                {
                    <div class="as-item">
                        @if (!string.IsNullOrEmpty(problema.ImageUrl))
                        {
                            <img class="as-item-miniatura" src="@problema.ImageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="as-item-miniatura" aria-hidden="true"><i class="bi bi-image"></i></div>
                        }

                        <div class="as-item-cuerpo">
                            <a class="as-item-titulo" asp-controller="Problema" asp-action="Details" asp-route-id="@problema.Id">@problema.Titulo</a>
                            <div class="as-item-linea">
                                <span class="as-item-categoria">@problema.Categoria</span>
                                <span class="as-item-datos">
                                    <span title="Soluciones propuestas"><i class="bi bi-lightbulb"></i> @problema.TotalSoluciones</span>
                                    <span title="Paso de la ruta del problema"><i class="bi bi-signpost-split"></i> @problema.Etapa/@RutaProblemaHelper.TotalPasos</span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Soluciones recientes -->
        <div class="col-md-6 col-lg-4">
            <div class="as-tarjeta as-tarjeta-soluciones">
                <div class="as-tarjeta-cabecera">
                    <h2 class="as-soluciones-titulo">Soluciones Recientes</h2>
                    <a asp-controller="Solucion" asp-action="Index" class="as-ver-todos">Ver todas</a>
                </div>

                @if (!Model.SolucionesRecientes.Any())
                {
                    <p class="text-muted small py-3 mb-0">Aún no hay soluciones publicadas.</p>
                }

                @foreach (var solucion in Model.SolucionesRecientes)
                {
                    var elegida = solucion.Estado == "Seleccionada" || solucion.Estado == "Implementada";
                    var icono = solucion.Estado == "Implementada" ? "bi-patch-check"
                              : solucion.Estado == "Seleccionada" ? "bi-check2-circle"
                              : "bi-lightbulb";

                    <div class="as-item">
                        <div class="as-item-icono @(elegida ? "es-elegida" : "")" aria-hidden="true"><i class="bi @icono"></i></div>

                        <div class="as-item-cuerpo">
                            <a class="as-item-titulo" asp-controller="Problema" asp-action="Details"
                               asp-route-id="@solucion.Problema_Id" asp-route-paso="3">@FeedHelper.Resumir(solucion.Descripcion, 70)</a>

                            @if (!string.IsNullOrWhiteSpace(solucion.ProblemaTitulo))
                            {
                                <div class="as-item-linea"><span class="text-truncate">Para: @solucion.ProblemaTitulo</span></div>
                            }

                            <div class="as-item-linea">
                                <span>Por: @solucion.UsuarioNombre</span>
                                <span class="as-item-datos">
                                    <span title="Me gusta"><i class="bi bi-hand-thumbs-up"></i> @solucion.TotalLikes</span>
                                    <span title="Comentarios"><i class="bi bi-chat"></i> @solucion.TotalComentarios</span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Únete -->
        <div class="col-12 col-lg-4">
            <div class="as-tarjeta as-tarjeta-unete">
                <div class="as-tarjeta-cabecera">
                    <h2>Únete a ASOFOTEC</h2>
                </div>
                <img src="~/img/landing/unete.png" alt="Cuatro personas celebrando juntas" loading="lazy" />
                <p>Sé parte del cambio. Tu talento y tus ideas pueden mejorar vidas.</p>
                <a asp-controller="Auth" asp-action="Register" class="btn btn-as mb-2">
                    <i class="bi bi-person-plus me-1"></i>Registrarse ahora
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ============ ESTADÍSTICAS (datos reales) ============ -->
<section class="as-stats" aria-label="ASOFOTEC en cifras">
    <div class="row row-cols-2 row-cols-lg-4 g-3">
        <div class="col">
            <div class="as-stat">
                <i class="bi bi-people" aria-hidden="true"></i>
                <div><strong>@Model.TotalUsuarios</strong><span>Miembros activos</span></div>
            </div>
        </div>
        <div class="col">
            <div class="as-stat">
                <i class="bi bi-lightbulb" aria-hidden="true"></i>
                <div><strong>@Model.TotalSoluciones</strong><span>Soluciones propuestas</span></div>
            </div>
        </div>
        <div class="col">
            <div class="as-stat">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <div><strong>@Model.TotalProyectos</strong><span>Proyectos en desarrollo</span></div>
            </div>
        </div>
        <div class="col">
            <div class="as-stat">
                <i class="bi bi-patch-check" aria-hidden="true"></i>
                <div><strong>@Model.TotalResueltos</strong><span>Problemas resueltos</span></div>
            </div>
        </div>
    </div>
</section>
