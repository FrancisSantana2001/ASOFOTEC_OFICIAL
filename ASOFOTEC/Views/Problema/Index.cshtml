@using ASOFOTEC.Dtos
@model List<ProblemaDto>


<div class ="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Problemas Sociales</h2>
            <p class="text-muted" mb-0>
                Explora problemas reales y contribuye con soluciones para mejorar nuestra comunidad.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            + Publicar un problema
        </a>
    </div>
    <!------Futuro Sidebar + Filtros------->
    <!--Por el momento esta vacio-->
    <div class="row">
        <!--Contenido principal-->
        <div class="col-12">
            @if(!Model.Any())
            {
                <div class="alert alert-info">
                    No hay problemas publicados.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach(var item in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">

                            <!--Cuerpo de la sección-->
                            <div class="card shadow-sm border-0 h-100">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="card-img-top" alt="Imagen del problema">
                                }
                               
                                <div class="card-body d-flex flex-column">
                                    <!--Categoria-->
                                    <span class="badge bg-success mb-2">
                                        @item.Categoria
                                    </span>

                                    <!--Titulo-->
                                    <h5 class="fw-semibold">
                                        @item.Titulo
                                    </h5>

                                    <!--Descripción-->
                                    <p class="text-muted small flex-grow-1">
                                        @(item.Descripcion.Length > 100
                                            ? item.Descripcion.Substring(0, 100) + "..."
                                            : item.Descripcion)
                                    </p>

                                    <!--Fecha-->
                                    <small class="text-secondary">
                                        @item.Fecha_Creacion.ToShortDateString()
                                    </small>

                                    <!--Footer-->
                                    <div class="card-footer bg-white border-0">
                                        <div class="d-flex justify-content-between">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-success btn-sm">
                                               Ver detalles
                                           </a>

                                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">
                                                Eliminar
                                            </a>
                                            <!--Para futuro-->
                                            <span class="text-muted">
                                                💬 0
                                            </span>
                                        </div>
                                    </div>


                                </div>

                            </div>




                        </div>
                    }
                </div>
            }
        </div>
     </div>



</div>
@{
}
