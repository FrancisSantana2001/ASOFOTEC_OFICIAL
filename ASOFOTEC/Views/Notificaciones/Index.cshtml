@using ASOFOTEC.Dtos
@model NotificacionesVm

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="mx-auto mt-2" style="max-width:720px">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h2 as-pagina-titulo mb-0">Notificaciones</h1>

        @if (Model.Items.Any(n => !n.Leida))
        {
            <form asp-action="MarcarTodas" method="post">
                <button type="submit" class="btn btn-sm btn-as-outline"><i class="bi bi-check2-all me-1"></i>Marcar todas como leídas</button>
            </form>
        }
    </div>

    <div class="as-tarjeta-simple p-0 overflow-hidden">
        <partial name="_NotificacionesLista" model="Model.Items" />
    </div>

    <div class="d-flex justify-content-between mt-3">
        @if (Model.Pagina > 1)
        {
            <a asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" class="btn btn-sm btn-as-outline">&larr; Más recientes</a>
        }
        else { <span></span> }

        @if (Model.HayMas)
        {
            <a asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" class="btn btn-sm btn-as-outline">Más antiguas &rarr;</a>
        }
    </div>
</div>
