@using ASOFOTEC.Dtos
@model List<SolucionDto>

@{
    var usuarioActualId = Context.ObtenerUsuarioId();
}

<div class="container mt-4">

    <h3 class="mb-4">Soluciones</h3>
    @foreach(var solution in Model)
    {
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-body">
                <p>@solution.Descripcion</p>

                <div class="d-flex justify-content-between">
                    <span class="badge gb-secondary">@solution.Estado</span>
                    <small>@solution.Fecha_Solucion.ToShortDateString()</small>
                    @if (Context.EsDba() || (usuarioActualId.HasValue && solution.UsuarioId == usuarioActualId.Value))
                    {
                        <form asp-action="Delete" method="post"
                              data-confirm="¿Deseas eliminar esta solución? Se borrarán también sus comentarios.">
                            <input type="hidden" name="id" value="@solution.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Eliminar
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

    }
</div>





@{
}
