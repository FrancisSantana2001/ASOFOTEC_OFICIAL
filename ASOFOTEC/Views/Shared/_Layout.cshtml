<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASOFOTEC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASOFOTEC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ASOFOTEC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Problema" asp-action="Index">Problemas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Solucion" asp-action="Create">Soluciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    @{
                        var nombre = Context.Session.GetString("Nombre");
                        var rol = Context.Session.GetString("Rol");
                    }

                    <div class="d-flex align-items-center gap-2 ms-auto">

                        @if (string.IsNullOrEmpty(nombre))
                        {
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn btn-outline-success">
                                Iniciar Sesión
                            </a>

                            <a asp-controller="Auth"
                               asp-action="Register"
                               class="btn btn-success">
                                Registrarse
                            </a>
                        }
                        else
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-success dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    @nombre
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                    @if (rol == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Index">
                                                Panel de Administración
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Problema"
                                               asp-action="Index">
                                                Gestionar Problemas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Solucion"
                                               asp-action="Index">
                                                Gestionar Soluciones
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Comentario"
                                               asp-action="Index">
                                                Gestionar Comentarios
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Usuario"
                                               asp-action="Index">
                                                Gestionar Usuarios
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Perfil"
                                               asp-action="Index">
                                                Mi Perfil
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Problema"
                                               asp-action="MisPublicaciones">
                                                Mis Publicaciones
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Solucion"
                                               asp-action="MisSoluciones">
                                                Mis Soluciones
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Comentario"
                                               asp-action="MisComentarios">
                                                Mis Comentarios
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Auth"
                                           asp-action="Logout">
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }

                    </div>

                    
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ASOFOTEC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
