@using ASOFOTEC.Dtos
@model FeedItemDto

@{
    var compartir = new CompartirVm
    {
        Url = Url.Action("Details", "Problema", new { id = Model.Id }, Context.Request.Scheme)!,
        Titulo = Model.Titulo ?? "Problema en ASOFOTEC"
    };
}

<article class="card feed-card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <partial name="_FeedCardHeader" model="Model" />

        @if (!string.IsNullOrEmpty(Model.Categoria))
        {
            <span class="badge bg-success mb-1">@Model.Categoria</span>
        }

        <h6 class="fw-semibold mb-1">
            <a asp-controller="Problema" asp-action="Details" asp-route-id="@Model.Id"
               class="text-decoration-none text-dark">@Model.Titulo</a>
        </h6>

        <p class="text-muted small mb-2 feed-text">@FeedHelper.Resumir(Model.Contenido, 220)</p>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="feed-img mb-2" alt="Imagen del problema" loading="lazy" />
        }

        <!-- En qué paso de la ruta va este problema (lo que distingue a ASOFOTEC de una red social común) -->
        <div class="ruta-mini mb-2">
            <div class="d-flex justify-content-between align-items-center small mb-1">
                <span class="fw-semibold text-@RutaProblemaHelper.Color(Model.Etapa)">
                    <i class="bi bi-signpost-split"></i> @RutaProblemaHelper.NombreEstado(Model.Etapa)
                </span>
                <span class="text-muted">Paso @Model.Etapa de @RutaProblemaHelper.TotalPasos</span>
            </div>
            <div class="progress" role="progressbar" aria-label="Paso de la ruta del problema"
                 aria-valuenow="@Model.Etapa" aria-valuemin="0" aria-valuemax="@RutaProblemaHelper.TotalPasos">
                <div class="progress-bar bg-@RutaProblemaHelper.Color(Model.Etapa)"
                     style="width:@(RutaProblemaHelper.Porcentaje(Model.Etapa))%"></div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 pt-2 border-top">
            <a asp-controller="Problema" asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-sm btn-outline-success">
                <i class="bi bi-lightbulb"></i> Soluciones (@Model.TotalSoluciones)
            </a>
            <div class="ms-auto d-flex align-items-center gap-1">
                <partial name="_Compartir" model="compartir" />
                <a asp-controller="Problema" asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-link text-decoration-none">Ver ruta <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>
    </div>
</article>
