@using System.Security.Claims
@{
    // Opciones del menú de cuenta (escritorio: desplegable del navbar; móvil: "Cuenta" de la barra inferior)
    var nombre = Context.Session.GetString("Nombre");
    if (string.IsNullOrEmpty(nombre)) nombre = Context.User.FindFirstValue(ClaimTypes.Name);
    var rol = Context.ObtenerRol();
}

<li><h6 class="dropdown-header text-truncate">@nombre</h6></li>

<li>
    <a class="dropdown-item" asp-controller="Perfil" asp-action="Index">
        <i class="bi bi-person-circle me-2"></i>Mi perfil
    </a>
</li>
<li>
    <a class="dropdown-item" asp-controller="Personas" asp-action="Index">
        <i class="bi bi-people me-2"></i>Personas
    </a>
</li>
<li>
    <a class="dropdown-item" asp-controller="Chat" asp-action="Index">
        <i class="bi bi-chat-dots me-2"></i>Mensajes
    </a>
</li>
<li>
    <a class="dropdown-item" asp-controller="Notificaciones" asp-action="Index">
        <i class="bi bi-bell me-2"></i>Notificaciones
    </a>
</li>

@if (rol == "DBA")
{
    <li>
        <a class="dropdown-item" asp-controller="Dba" asp-action="Index">
            <i class="bi bi-speedometer2 me-2"></i>Panel DBA
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Dba" asp-action="Usuarios">
            <i class="bi bi-people me-2"></i>Gestionar usuarios
        </a>
    </li>
}

@if (rol == "Admin" || rol == "DBA")
{
    <li>
        <a class="dropdown-item" asp-controller="Problema" asp-action="Index">
            <i class="bi bi-exclamation-circle me-2"></i>Gestionar problemas
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Solucion" asp-action="Index">
            <i class="bi bi-lightbulb me-2"></i>Gestionar soluciones
        </a>
    </li>
    <li><hr class="dropdown-divider" /></li>
}

<li>
    <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
    </a>
</li>
