@* Campana de notificaciones. La cantidad sin leer y la lista se cargan por JavaScript (social.js) *@
<div class="dropdown notif-dropdown">
    <button type="button" class="notif-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside"
            data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="Notificaciones">
        <i class="bi bi-bell"></i>
        <span class="notif-badge d-none" aria-live="polite">0</span>
    </button>

    <div class="dropdown-menu dropdown-menu-end notif-menu shadow border-0 p-0">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>Notificaciones</strong>
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none btn-marcar-todas">Marcar todas como leídas</button>
        </div>

        <div class="notif-lista">
            <div class="text-center text-muted small py-4">Cargando...</div>
        </div>

        <a class="d-block text-center small py-2 border-top text-decoration-none" asp-controller="Notificaciones" asp-action="Index">Ver todas</a>
    </div>
</div>
