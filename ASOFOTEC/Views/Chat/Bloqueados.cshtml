@using ASOFOTEC.Dtos
@model List<PersonaDto>

@{
    ViewData["Title"] = "Personas bloqueadas";
}

<div class="mx-auto mt-2" style="max-width:640px">
    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none ps-0 mb-2"><i class="bi bi-arrow-left"></i> Mensajes</a>

    <h1 class="h2 as-pagina-titulo">Personas bloqueadas</h1>
    <p class="text-muted small">
        Las personas bloqueadas no pueden escribirte ni seguirte, y tú tampoco a ellas. No se les avisa que las bloqueaste.
    </p>

    <div class="as-tarjeta-simple">
        @if (!Model.Any())
        {
            <p class="text-muted text-center mb-0 py-3">No tienes personas bloqueadas.</p>
        }

        @foreach (var persona in Model)
        {
            var avatar = AvatarVm.De(persona.Nombre, persona.FotoUrl, "feed-avatar");

            <div class="d-flex align-items-center gap-2 py-2 persona-item">
                <partial name="_Avatar" model="avatar" />
                <div class="flex-grow-1 fw-semibold small text-truncate">@persona.Nombre</div>
                <button type="button" class="btn btn-sm btn-as-outline btn-bloquear"
                        data-usuario-id="@persona.Id" data-nombre="@persona.Nombre" data-bloqueado="1">Desbloquear</button>
            </div>
        }
    </div>
</div>
